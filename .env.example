# Google Apps Script Web App URL, for example https://script.google.com/macros/s/DEPLOYMENT_ID/exec
VITE_API_URL=
# Must match the Apps Script API_TOKEN property
VITE_API_TOKEN=

# Single-login admin account for local development/deployment configuration.
# Keep the real password in .env.local / hosting secrets; never commit it.
VITE_ADMIN_USERNAME=admin
VITE_ADMIN_PASSWORD=
